---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <h3>{project.name}</h3>
  <p>{project.summary}</p>
  <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
  <p class="links">
    {project.links.map((link) => <a href={link.href}>{link.label}</a>)}
  </p>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
  }
  .card p {
    margin-bottom: 0.5rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }
</style>
