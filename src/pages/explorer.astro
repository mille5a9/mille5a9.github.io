---
import Base from "../layouts/Base.astro";
import { sports, LIBRARY_VERSION } from "../data/apiSports";
---

<Base
  title="api-sports-kotlin explorer"
  description="Try every method of the api-sports-kotlin NBA and NFL clients against the live API-SPORTS APIs, and see the matching Kotlin."
>
  <h1>api-sports-kotlin explorer</h1>
  <p>
    Pick a method from <a href="https://github.com/mille5a9/api-sports-kotlin">api-sports-kotlin</a>, my Kotlin
    clients for the <a href="https://api-sports.io">API-SPORTS</a> NBA and American football APIs, and run the
    request it makes against the live API. The Kotlin next to it gets you the same data from the library.
  </p>
  <p class="muted small">
    Snippets target <code>{LIBRARY_VERSION}</code>. Full reference in the <a href="/api-sports-kotlin/">API docs</a>.
  </p>

  <section class="panel key">
    <label for="apiKey">Your API-SPORTS key</label>
    <div class="row">
      <input id="apiKey" type="password" autocomplete="off" spellcheck="false" placeholder="Paste your key" />
      <button type="button" id="toggleKey" class="secondary">Show</button>
    </div>
    <label class="check"><input type="checkbox" id="rememberKey" /> Remember it in this browser</label>
    <p class="muted small">
      One key works for both APIs. Requests go from your browser straight to <code>api-sports.io</code>, and the key
      is never sent anywhere else. You can get a free key at
      <a href="https://dashboard.api-football.com/register">api-sports.io</a>.
    </p>
  </section>

  <div class="wide">
    <div class="layout">
      <section class="panel">
        <fieldset class="sports">
          <legend class="sr-only">API</legend>
          {
            sports.map((s, i) => (
              <label class="sport">
                <input type="radio" name="sport" value={s.id} checked={i === 0} />
                <span>{s.label}</span>
              </label>
            ))
          }
        </fieldset>
        <p id="apiName" class="muted small"></p>
        <label for="method">Method</label>
        <select id="method"></select>
        <p id="summary" class="muted"></p>
        <form id="params"></form>
        <button type="button" id="run">Run request</button>
        <p class="muted small request">
          <span class="label">Request</span>
          <code id="requestLine"></code>
        </p>
      </section>

      <section class="panel code">
        <div class="code-head">
          <span class="label">Kotlin</span>
          <button type="button" class="secondary small-btn" data-copy="kotlin">Copy</button>
        </div>
        <pre><code id="kotlin"></code></pre>
        <details>
          <summary>Gradle dependency</summary>
          <pre><code id="gradle"></code></pre>
        </details>
      </section>
    </div>

    <section class="panel response" aria-live="polite">
      <div class="code-head">
        <span class="label">Response</span>
        <span id="status" class="muted small"></span>
        <button type="button" class="secondary small-btn" data-copy="json" hidden>Copy</button>
      </div>
      <p id="error" class="error" hidden></p>
      <pre id="jsonWrap" hidden><code id="json"></code></pre>
      <button type="button" id="showAll" class="secondary" hidden>Show the full response</button>
      <p id="empty" class="muted">Run a request to see the response here.</p>
    </section>
  </div>
</Base>

<script>
  import { sports, LIBRARY_VERSION, type ApiMethod, type MethodParam, type SportApi } from "../data/apiSports";

  const KEY_STORAGE = "api-sports-explorer-key";
  const OLD_KEY_STORAGE = "api-nba-explorer-key";
  const PREVIEW_CHARS = 40_000;
  const LEAGUE_CONSTANTS: Record<string, string> = { "1": "NFL", "2": "NCAA" };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const keyInput = $<HTMLInputElement>("apiKey");
  const remember = $<HTMLInputElement>("rememberKey");
  const methodSelect = $<HTMLSelectElement>("method");
  const form = $<HTMLFormElement>("params");
  const runButton = $<HTMLButtonElement>("run");
  const kotlinEl = $("kotlin");
  const jsonEl = $("json");
  const jsonWrap = $("jsonWrap");
  const errorEl = $("error");
  const statusEl = $("status");
  const emptyEl = $("empty");
  const showAll = $<HTMLButtonElement>("showAll");
  const copyJson = document.querySelector<HTMLButtonElement>('[data-copy="json"]')!;
  const sportRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="sport"]')];

  let sport: SportApi = sports[0];
  let fullJson = "";

  // localStorage can be missing or throw (private windows, blocked storage); the page works without it.
  const storage = {
    get(key: string) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set(key: string, value: string | null) {
      try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch {
        /* ignore */
      }
    },
  };

  const savedKey = storage.get(KEY_STORAGE) ?? storage.get(OLD_KEY_STORAGE);
  if (savedKey) {
    keyInput.value = savedKey;
    remember.checked = true;
    storage.set(KEY_STORAGE, savedKey);
    storage.set(OLD_KEY_STORAGE, null);
  }
  remember.addEventListener("change", () => storage.set(KEY_STORAGE, remember.checked ? keyInput.value : null));
  keyInput.addEventListener("input", () => {
    if (remember.checked) storage.set(KEY_STORAGE, keyInput.value);
  });
  $("toggleKey").addEventListener("click", (e) => {
    const shown = keyInput.type === "text";
    keyInput.type = shown ? "password" : "text";
    (e.currentTarget as HTMLButtonElement).textContent = shown ? "Show" : "Hide";
  });

  const current = (): ApiMethod => sport.methods.find((m) => m.id === methodSelect.value)!;

  function values(method: ApiMethod): string[] {
    return method.params.map((p) => (form.elements.namedItem(p.name) as HTMLInputElement | null)?.value.trim() ?? "");
  }

  function query(method: ApiMethod, vals: string[]): URLSearchParams {
    const q = new URLSearchParams();
    const h2h: string[] = [];
    method.params.forEach((p, i) => {
      if (p.combine) h2h[p.combine === "h2h-first" ? 0 : 1] = vals[i];
      else if (vals[i] !== "" || !p.optional) q.set(p.query, vals[i]);
    });
    if (h2h.length) q.set("h2h", `${h2h[0] ?? ""}-${h2h[1] ?? ""}`);
    for (const [k, v] of Object.entries(method.fixed ?? {})) q.set(k, v);
    return q;
  }

  function requestUrl(method: ApiMethod, vals: string[]): string {
    const q = query(method, vals).toString();
    return sport.baseUrl + method.endpoint + (q ? `?${q}` : "");
  }

  function kotlinLiteral(p: MethodParam, value: string): string {
    if (p.type === "Int") {
      if (!/^-?\d+$/.test(value)) return `/* ${value ? "not a number" : "Int"} */ 0`;
      if (p.league && LEAGUE_CONSTANTS[value]) return `${sport.client}.${LEAGUE_CONSTANTS[value]}`;
      return value;
    }
    if (p.type === "Boolean") return value === "true" ? "true" : "false";
    return JSON.stringify(value);
  }

  function kotlin(method: ApiMethod, vals: string[]): string {
    const v = sport.variable;
    const used = method.params
      .map((p, i) => ({ p, value: vals[i] }))
      .filter(({ p, value }) => !(p.optional && value === ""));

    let call: string[];
    if (method.dsl) {
      call = used.length
        ? [`${v}.${method.name} {`, ...used.map(({ p, value }) => `    ${p.name} = ${kotlinLiteral(p, value)}`), "}"]
        : [`${v}.${method.name} { }`];
    } else {
      const args = used.map(({ p, value }) => `${p.name} = ${kotlinLiteral(p, value)}`);
      call =
        args.length <= 1 ? [`${v}.${method.name}(${args.join("")})`] : [`${v}.${method.name}(`, ...args.map((a) => `    ${a},`), ")"];
    }
    const indent = (line: string) => `        ${line}`;
    const usage = method.returns === "ApiResponse<AccountStatus>" ? "println(result.response)" : "result.response.forEach(::println)";
    return [
      `import ${sport.pkg}.${sport.client}`,
      "",
      "suspend fun main() {",
      `    ${sport.client}(System.getenv("API_SPORTS_KEY")).use { ${v} ->`,
      `        // ${method.returns}`,
      indent(`val result = ${call[0]}`),
      ...call.slice(1).map(indent),
      indent(usage),
      "    }",
      "}",
    ].join("\n");
  }

  function note(text: string) {
    const p = document.createElement("p");
    p.className = "muted small";
    p.textContent = text;
    return p;
  }

  function renderMethods(selected?: string) {
    methodSelect.replaceChildren();
    const groups = [...new Set(sport.methods.map((m) => m.group))];
    for (const group of groups) {
      const og = document.createElement("optgroup");
      og.label = group;
      for (const m of sport.methods.filter((x) => x.group === group)) {
        const opt = document.createElement("option");
        opt.value = m.id;
        opt.textContent = m.dsl ? `${m.name} { … }` : m.name;
        og.append(opt);
      }
      methodSelect.append(og);
    }
    methodSelect.value = sport.methods.some((m) => m.id === selected) ? selected! : sport.defaultMethod;
    const apiName = $("apiName");
    apiName.replaceChildren(`${sport.client} · `);
    const a = document.createElement("a");
    a.href = sport.docsUrl;
    a.textContent = sport.apiName;
    apiName.append(a);
    $("gradle").textContent = `implementation("io.github.mille5a9:${sport.artifact}:${LIBRARY_VERSION}")`;
    renderParams();
  }

  function renderParams() {
    const method = current();
    $("summary").textContent = method.summary;
    form.replaceChildren();
    for (const p of method.params) {
      const field = document.createElement("div");
      field.className = "field";
      const label = document.createElement("label");
      label.htmlFor = `p-${p.name}`;
      const name = document.createElement("code");
      name.textContent = p.name;
      const type = document.createElement("span");
      type.className = "muted";
      type.textContent = `: ${p.type}${p.optional ? "?" : ""}`;
      label.append(name, type);
      const input = document.createElement("input");
      input.id = `p-${p.name}`;
      input.name = p.name;
      input.value = p.example ?? "";
      input.required = !p.optional;
      input.autocomplete = "off";
      if (p.type === "Int") input.inputMode = "numeric";
      field.append(label, input);
      if (p.hint) field.append(note(p.hint));
      form.append(field);
    }
    const fixed = Object.entries(method.fixed ?? {})
      .map(([k, v]) => `${k}=${v}`)
      .join(", ");
    if (!method.params.length) form.append(note(fixed ? `No arguments. The method always sends ${fixed}.` : "No arguments."));
    else if (fixed) form.append(note(`The method also sends ${fixed}.`));
    update();
  }

  function update() {
    const method = current();
    const vals = values(method);
    kotlinEl.textContent = kotlin(method, vals);
    $("requestLine").textContent = `GET ${requestUrl(method, vals)}`;
    try {
      history.replaceState(null, "", `#${sport.id}/${method.id}`);
    } catch {
      /* ignore */
    }
  }

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function showJson(text: string) {
    fullJson = text;
    const big = text.length > PREVIEW_CHARS;
    jsonEl.textContent = big ? `${text.slice(0, PREVIEW_CHARS)}\n…` : text;
    showAll.hidden = !big;
    showAll.textContent = `Show the full response (${Math.round(text.length / 1024)} KB)`;
    jsonWrap.hidden = false;
    copyJson.hidden = false;
  }

  async function run() {
    const method = current();
    const key = keyInput.value.trim();
    errorEl.hidden = true;
    if (!key) {
      showError("Paste your API-SPORTS key above first.");
      keyInput.focus();
      return;
    }
    if (!form.reportValidity()) return;

    const vals = values(method);
    const badInt = method.params.find((p, i) => p.type === "Int" && vals[i] !== "" && !/^-?\d+$/.test(vals[i]));
    if (badInt) {
      showError(`${badInt.name} must be a whole number.`);
      return;
    }

    runButton.disabled = true;
    runButton.textContent = "Running…";
    statusEl.textContent = "";
    emptyEl.hidden = true;
    const started = performance.now();
    try {
      const res = await fetch(requestUrl(method, vals), { headers: { "x-apisports-key": key } });
      const text = await res.text();
      const ms = Math.round(performance.now() - started);
      let body: { results?: number; errors?: unknown } | null = null;
      try {
        body = JSON.parse(text);
        showJson(JSON.stringify(body, null, 2));
      } catch {
        showJson(text);
      }
      const results = typeof body?.results === "number" ? ` · ${body.results} result${body.results === 1 ? "" : "s"}` : "";
      statusEl.textContent = `HTTP ${res.status} · ${ms} ms${results}`;

      // The library throws ApiSportsException for any of these.
      const errors = body?.errors;
      const errorList = Array.isArray(errors)
        ? errors.map(String)
        : errors && typeof errors === "object"
          ? Object.entries(errors).map(([k, v]) => `${k}: ${v}`)
          : [];
      const tokenError = errors && typeof errors === "object" && !Array.isArray(errors) && "token" in errors;
      if (tokenError) showError("The API didn't accept that key. Check it on your API-SPORTS dashboard.");
      else if (errorList.length) showError(`The API returned an error. ${errorList.join(" ")}`);
    } catch {
      showError("The request didn't go through. Check your connection and try again.");
    } finally {
      runButton.disabled = false;
      runButton.textContent = "Run request";
    }
  }

  function setSport(id: string, method?: string) {
    sport = sports.find((s) => s.id === id) ?? sports[0];
    for (const r of sportRadios) r.checked = r.value === sport.id;
    renderMethods(method);
  }

  sportRadios.forEach((r) => r.addEventListener("change", () => setSport(r.value)));
  methodSelect.addEventListener("change", renderParams);
  form.addEventListener("input", update);
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    run();
  });
  runButton.addEventListener("click", run);
  showAll.addEventListener("click", () => {
    jsonEl.textContent = fullJson;
    showAll.hidden = true;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy === "json" ? fullJson : (kotlinEl.textContent ?? "");
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Couldn't copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
  });

  // #nfl/getStandings, or the old #getTeamByCode form (NBA).
  const hash = decodeURIComponent(location.hash.slice(1));
  const [first, second] = hash.split("/");
  if (second !== undefined) setSport(first, second);
  else setSport("nba", first || undefined);
</script>

<style>
  .small {
    font-size: 0.88rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    margin-top: 1rem;
    min-width: 0;
  }
  .layout {
    display: grid;
    gap: 0 1rem;
  }
  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  label.check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
    margin-top: 0.6rem;
  }
  .sports {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3px;
    margin: 0 0 0.4rem;
    gap: 3px;
  }
  label.sport {
    margin: 0;
    font-weight: 500;
    font-size: 0.92rem;
    cursor: pointer;
  }
  label.sport input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  label.sport span {
    display: block;
    padding: 0.3rem 0.85rem;
    border-radius: 6px;
    color: var(--muted);
  }
  label.sport input:checked + span {
    background: var(--accent-soft);
    color: var(--text);
  }
  label.sport input:focus-visible + span {
    outline: 2px solid var(--accent);
  }
  #apiName {
    margin: 0 0 0.9rem;
  }
  .row {
    display: flex;
    gap: 0.5rem;
  }
  input:not([type="checkbox"]):not([type="radio"]),
  select {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.45rem 0.6rem;
  }
  input:focus-visible,
  select:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  #summary {
    margin: 0.6rem 0 0.9rem;
  }
  /* Elements created by the script don't get Astro's scoped class, so style the form's contents globally. */
  #params :global(.field) {
    margin-bottom: 0.8rem;
  }
  #params :global(label) {
    display: block;
    font-weight: 400;
    margin-bottom: 0.35rem;
  }
  #params :global(input) {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.45rem 0.6rem;
  }
  #params :global(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  #params :global(p) {
    margin: 0.3rem 0 0;
  }
  #params :global(.muted) {
    color: var(--muted);
  }
  #params :global(.small) {
    font-size: 0.88rem;
  }
  button {
    font: inherit;
    font-size: 0.95rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--surface);
    border-radius: 7px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    white-space: nowrap;
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  button.secondary {
    background: transparent;
    color: var(--accent);
  }
  .small-btn {
    font-size: 0.8rem;
    padding: 0.15rem 0.6rem;
    margin-left: auto;
  }
  .request {
    margin: 0.9rem 0 0;
    overflow-wrap: anywhere;
  }
  .request .label {
    display: block;
    margin-bottom: 0.2rem;
  }
  .code-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  pre {
    margin: 0;
    padding: 0.8rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    overflow: auto;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .response pre {
    max-height: 32rem;
  }
  details {
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }
  summary {
    cursor: pointer;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .error {
    color: #b3261e;
    margin: 0 0 0.6rem;
  }
  @media (prefers-color-scheme: dark) {
    .error {
      color: #f2a19a;
    }
  }
  #run {
    margin-top: 0.4rem;
  }
  #showAll {
    margin-top: 0.6rem;
  }
  #empty {
    margin: 0;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
    .wide {
      width: min(66rem, calc(100vw - 32px));
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
